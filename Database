CREATE TABLE Students (
    ID INT PRIMARY KEY,
    First_Name VARCHAR(20),
    Last_Name VARCHAR(20),
    Age INT,
    Phone VARCHAR(20),
    Grade VARCHAR(10),
    Class VARCHAR(10),
    Section VARCHAR(10)
);


